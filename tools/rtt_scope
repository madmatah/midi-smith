#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/.." && pwd)"

if command -v uv >/dev/null 2>&1; then
    exec uv run \
        --directory "${repo_root}" \
        --only-group rtt-scope \
        --frozen \
        python -m tools.rtt_scope_app "$@"
fi

cd "${repo_root}"

if command -v python3 >/dev/null 2>&1; then
    exec python3 -m tools.rtt_scope_app "$@"
fi

exec python -m tools.rtt_scope_app "$@"
