{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ADC: configure+build Debug",
      "type": "shell",
      "command": "cmake --preset adc-Debug && cmake --build --preset adc-Debug --target adc-board",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "ADC: configure+build Release",
      "type": "shell",
      "command": "cmake --preset adc-Release && cmake --build --preset adc-Release --target adc-board",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Main: configure+build Debug",
      "type": "shell",
      "command": "cmake --preset main-Debug && cmake --build --preset main-Debug --target main-board",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Main: configure+build Release",
      "type": "shell",
      "command": "cmake --preset main-Release && cmake --build --preset main-Release --target main-board",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Host: configure+build tests",
      "type": "shell",
      "command": "cmake --preset Host-Debug && cmake --build --preset Host-Debug --target all",
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Host: run tests",
      "type": "shell",
      "command": "cmake --preset Host-Debug && ctest --preset Host-Debug --output-on-failure",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "CMake: format",
      "type": "shell",
      "command": "cmake --build --preset Host-Debug --target format",
      "group": "build",
      "problemMatcher": [],
      "detail": "Format code"
    },
    {
      "label": "CMake: lint",
      "type": "shell",
      "command": "cmake --build --preset Host-Debug --target lint",
      "group": "build",
      "problemMatcher": [],
      "detail": "Lint code"
    },
    {
      "label": "Boot: configure+build Debug",
      "type": "shell",
      "command": "cmake --preset boot-Debug && cmake --build --preset boot-Debug --target bootloader",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "Boot: configure+build Release",
      "type": "shell",
      "command": "cmake --preset boot-Release && cmake --build --preset boot-Release --target bootloader",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "Main: build bootloader (Release) + application (Debug)",
      "type": "shell",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "dependsOn": [
        "Boot: configure+build Release",
        "Main: configure+build Debug"
      ],
      "dependsOrder": "sequence",
      "command": "echo built"
    },
    {
      "label": "ADC: build bootloader (Release) + application (Debug)",
      "type": "shell",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "dependsOn": [
        "Boot: configure+build Release",
        "ADC: configure+build Debug"
      ],
      "dependsOrder": "sequence",
      "command": "echo built"
    },
    {
      "label": "Flash: provision a new board (bootloader + main-board, Release)",
      "type": "shell",
      "command": "python3 tools/flash_board.py --board main --with-bootloader",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "Flash: provision a new board (bootloader + adc-board, Release)",
      "type": "shell",
      "command": "python3 tools/flash_board.py --board adc --with-bootloader",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "Flash: main-board Release",
      "type": "shell",
      "command": "python3 tools/flash_board.py --board main",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "Flash: adc-board Release",
      "type": "shell",
      "command": "python3 tools/flash_board.py --board adc",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "Flash: list ST-LINK probes",
      "type": "shell",
      "command": "python3 tools/flash_board.py --list-probes",
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    }
  ]
}
